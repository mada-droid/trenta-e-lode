{
  "name": "trenta-e-lode",
  "productName": "Trenta e Lode",
  "version": "1.1.1",
  "description": "A free study planner for university students: your own subjects, a study plan generated from your files, Pomodoro with a lofi focus mode, flashcards, prayer times for any city, adhkar and Qur'an reminders.",
  "main": "main.js",
  "license": "MIT",
  "author": "Trenta e Lode contributors",
  "homepage": "https://github.com/mada-droid/trenta-e-lode",
  "repository": { "type": "git", "url": "https://github.com/mada-droid/trenta-e-lode.git" },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "adhan": "^4.4.3",
    "katex": "^0.16.11"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.trentaelode",
    "productName": "Trenta e Lode",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "preload-overlay.js", "src/**/*", "assets/**/*", "build/icon.png", "build/icon-48.png", "LICENSE", "package.json"],
    "win": { "icon": "build/icon.ico", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Trenta e Lode", "artifactName": "Trenta-e-Lode-Setup-${version}.${ext}" },
    "portable": { "artifactName": "Trenta-e-Lode-${version}-portable.exe" },
    "mac": { "icon": "build/icon-1024.png", "category": "public.app-category.education" },
    "linux": { "icon": "build/icon-1024.png", "category": "Education" }
  }
}
